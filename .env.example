# RIK Athletica unified site environment variables
# Copy this file to .env.local for local dev. Never commit .env.local.
# In production, set all of these in Vercel dashboard.

# ============================================
# AUDIT BACKEND (from rik-audit project)
# ============================================

# Postgres database (Neon, sin1 region per handover)
POSTGRES_URL=postgres://...

# Vercel Blob storage (currently unused — PDF disabled, kept for future revival)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Anthropic Claude (audit AI drafting)
ANTHROPIC_API_KEY=sk-ant-...

# Kit (ConvertKit) — 11 tags configured (audit lifecycle, conversions, abandonment)
KIT_API_KEY=...
KIT_API_SECRET=...
KIT_TAG_AUDIT_PENDING=...
KIT_TAG_AUDIT_DELIVERED=...
KIT_TAG_AUDIT_TIER_1=...
KIT_TAG_AUDIT_TIER_2=...
KIT_TAG_AUDIT_TIER_3=...
KIT_TAG_AUDIT_TIER_4=...
KIT_TAG_PURCHASED_BUNDLE=...
KIT_TAG_PURCHASED_SPRINT=...
KIT_TAG_PURCHASED_PREMIUM=...
KIT_TAG_AUDIT_ABANDONED=...
KIT_TAG_CALC_COMPLETED=...

# ============================================
# STRIPE
# ============================================

STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Payment Links (do NOT hardcode in HTML; use these env vars)
STRIPE_LINK_FULL=https://buy.stripe.com/...
STRIPE_LINK_703=https://buy.stripe.com/...
# Bundle payment link is currently hardcoded:
# https://buy.stripe.com/4gM7sN6Wq3cc7T0fZ67Re00
# Per CLAUDE.md, do not change without confirming with the operator

# ============================================
# EMAIL (Gmail SMTP)
# ============================================

GMAIL_USER=bek.zhou@rikathletica.com
GMAIL_APP_PASSWORD=...
BEK_NOTIFY_EMAIL=bek.zhou@rikathletica.com

# Internal alert email (audit screening alerts, race pack alerts)
INTERNAL_ALERT_EMAIL=bek.zhou@rikathletica.com

# ============================================
# AUTH
# ============================================

ADMIN_TOKEN=...

# ============================================
# CRON
# ============================================

CRON_SECRET=...

# ============================================
# TYPEFORM (Sprint v2 intake + screening)
