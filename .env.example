# RIK Athletica unified site environment variables
# Copy this file to .env.local for local dev. Never commit .env.local.
# In production, set all of these in Vercel dashboard.

# ============================================
# AUDIT BACKEND (from rik-audit project)
# ============================================

# Postgres database (Neon, sin1 region per handover)
POSTGRES_URL=postgres://...

# Vercel Blob storage (currently unused — PDF disabled, kept for future revival)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Anthropic Claude (audit AI drafting)
ANTHROPIC_API_KEY=sk-ant-...

# Kit (ConvertKit) — names must match exactly what's in lib/kit.js
# Auth: v4 Bearer token (format kit_...). The same secret works for v3 endpoints.
KIT_API_SECRET=kit_...

# ── Audit lifecycle (4 tags) — IDs from Kit dashboard ──
# Set when /api/audit/submit fires (lead captured pre-delivery):
KIT_TAG_AUDIT_SUBMITTED=...
# Set when admin approves+sends the audit via /api/audit/approve:
KIT_TAG_AUDIT_DELIVERED=...
# Set by /api/cron/daily-sweep ~7 days post-delivery if no purchase:
KIT_TAG_AUDIT_NO_CONVERT=...
# Set when an audit recipient later converts (via /api/stripe-webhook):
KIT_TAG_AUDIT_CONVERTED=...

# ── Tier routing at audit delivery (4 tags) — branches the post-audit nurture ──
KIT_TAG_TIER_BUNDLE=...
KIT_TAG_TIER_BUNDLE_PDF=...
KIT_TAG_TIER_SPRINT=...
KIT_TAG_TIER_PREMIUM=...

# ── Conversion tier (3 tags) — set in addition to AUDIT_CONVERTED ──
KIT_TAG_CONVERTED_BUNDLE=...
KIT_TAG_CONVERTED_SPRINT=...
KIT_TAG_CONVERTED_PREMIUM=...

# Note: the following tags are resolved by NAME via Kit v4 API (no env var needed,
# but the tag must exist in Kit dashboard with EXACTLY this name):
#   cart-recovery-bundle
#   cart-recovery-sprint
#   cart-recovery-premium
#   STRIPE_CONVERSION_BUNDLE   (applied on Bundle purchase — drives Sequence 1)
#   STRIPE_CONVERSION_SPRINT   (applied on Sprint/Premium purchase — Sequence 1 exit signal)
# Retired (do not re-create, no code path applies them now):
#   post-audit-nurture
#   bundle-to-sprint-upsell

# ============================================
# REWARDFUL (subscriber referral lookup via /api/refer)
# ============================================
#
# /api/refer?email=... looks up the affiliate link for a subscriber and 302s.
# Used by Kit emails to embed per-subscriber referral URLs.
# REWARDFUL_KEY below is the public site tracking key; this is the secret API key.
REWARDFUL_API_SECRET=...
# Optional — restrict /api/refer affiliate lookup + creation to one campaign.
REWARDFUL_CAMPAIGN_ID=...

# ============================================
# STRIPE
# ============================================

STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Payment Links (do NOT hardcode in HTML; use these env vars)
STRIPE_LINK_FULL=https://buy.stripe.com/...
STRIPE_LINK_703=https://buy.stripe.com/...
# Bundle payment link is currently hardcoded:
# https://buy.stripe.com/4gM7sN6Wq3cc7T0fZ67Re00
# Per CLAUDE.md, do not change without confirming with the operator

# ============================================
# EMAIL (Gmail SMTP)
# ============================================

GMAIL_USER=bek.zhou@rikathletica.com
GMAIL_APP_PASSWORD=...
BEK_NOTIFY_EMAIL=bek.zhou@rikathletica.com

# Internal alert email (audit screening alerts, race pack alerts)
INTERNAL_ALERT_EMAIL=bek.zhou@rikathletica.com

# ============================================
# AUTH
# ============================================

ADMIN_TOKEN=...

# ============================================
# CRON
# ============================================

CRON_SECRET=...

# ============================================
# TYPEFORM (Sprint v2 intake + screening)
# ============================================

TYPEFORM_WEBHOOK_SECRET=...

# ============================================
# DROPBOX SIGN (Sprint contract signing)
# ============================================

DROPBOX_SIGN_API_KEY=...
DROPBOX_SIGN_TEMPLATE_FULL=...
DROPBOX_SIGN_TEMPLATE_703=...

# ============================================
# RESEND (transactional email backup; primary is Gmail SMTP)
# ============================================

RESEND_API_KEY=re_...

# ============================================
# REWARDFUL (affiliate tracking)
# ============================================

REWARDFUL_KEY=...

# ============================================
# ANALYTICS (per Phase 1.6 instrumentation spec)
# ============================================

GA4_MEASUREMENT_ID=G-...
